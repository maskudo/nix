#!/usr/bin/env bash
function send_notification() {
  brightness=$(brightnessctl -m | cut -d, -f4 | tr -d '%')
  dunstify -a "changebrightness" -u low -r 9991 -h int:value:"$brightness" -i "brightness-$1" "Brightness: $brightness%" -t 2000
}
delta="${2:-5}%"

case $1 in
up)
  brightnessctl set "+$delta"
  send_notification $1
  ;;
down)
  brightnessctl set "$delta-"
  send_notification $1
  ;;
esac
